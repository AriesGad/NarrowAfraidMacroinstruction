{
  "expo": {
    "name": "Aries Tunnel",
    "slug": "aries-tunnel",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "aries-tunnel",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#b6000b",
      "image": "./assets/images/aries-splash.jpeg",
      "resizeMode": "cover"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
